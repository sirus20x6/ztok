# Zig build artifacts
.zig-cache/
zig-out/
*.a
*.so
*.so.*
*.dylib
*.dll
*.o
*.obj

# Stray build outputs / crash dumps
libroot.a
vgcore.*
core.*
*.core

# Benchmark scratch (regeneratable; results NDJSON kept out of history)
.benchmarks/
bench/_results/
bench/_cache/
bench/corpora/_cache/

# Vendored reference clones (shallow git clones of tiktoken / HF tokenizers /
# SentencePiece / TokenMonster — fetched separately, not part of ztok source).
# The ztok ports that reference them live in src/.
refs/

# Python
**/__pycache__/
*.pyc
.pytest_cache/

# Node.js binding
bindings/nodejs/node_modules/
bindings/nodejs/dist/

# Rust binding
bindings/rust/target/
bindings/rust/Cargo.lock

# .NET binding
bindings/dotnet/**/bin/
bindings/dotnet/**/obj/

# Java binding
bindings/java/target/
**/*.class

# Swift binding
bindings/swift/.build/

# VS Code extension
tools/vscode-ztok/node_modules/
tools/vscode-ztok/out/
tools/vscode-ztok/.vscode-test/
tools/vscode-ztok/*.vsix

# Demo site vendored WASM (regenerated by zig build ztok-wasm-browser)
demo/vendor/*.wasm

# OS
.DS_Store
Thumbs.db
